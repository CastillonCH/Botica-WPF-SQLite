<Window x:Class="Botica.App.Views.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Copias de seguridad" Height="450" Width="550"
        MinHeight="350" MinWidth="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Mensaje}" Foreground="DarkGreen" TextWrapping="Wrap" />

        <TextBlock Grid.Row="2" Text="Historial de respaldos" FontWeight="Bold" Margin="0,0,0,4"
                    VerticalAlignment="Top" />
        <ListBox Grid.Row="2" Margin="0,24,0,0" ItemsSource="{Binding Respaldos}"
                  SelectedItem="{Binding RespaldoSeleccionado, Mode=TwoWay}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Crear respaldo" Command="{Binding CrearRespaldoCommand}" Height="36" />
            <Button Grid.Column="2" Content="Restaurar seleccionado" Click="RestaurarButton_Click" Height="36"
                    Style="{StaticResource Style.DangerButton}" />
        </Grid>
    </Grid>
</Window>
