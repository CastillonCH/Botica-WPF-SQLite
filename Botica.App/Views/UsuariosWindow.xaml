<Window x:Class="Botica.App.Views.UsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Usuarios" Height="520" Width="750"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" ItemsSource="{Binding Usuarios}"
                  SelectedItem="{Binding UsuarioSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="100" />
                <DataGridTextColumn Header="Nombre completo" Binding="{Binding NombreCompleto}" Width="*" />
                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="100" />
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Usuario" Margin="0,0,0,4" />
            <TextBox Text="{Binding UsuarioSeleccionado.NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Nombre completo" Margin="0,8,0,4" />
            <TextBox Text="{Binding UsuarioSeleccionado.NombreCompleto, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Rol" Margin="0,8,0,4" />
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding UsuarioSeleccionado.Rol}" />

            <TextBlock Text="Contraseña (dejar vacío para no cambiar)" Margin="0,8,0,4" TextWrapping="Wrap" />
            <PasswordBox x:Name="PasswordBox" />

            <CheckBox Content="Activo" IsChecked="{Binding UsuarioSeleccionado.Activo}" Margin="0,12,0,0" />

            <TextBlock Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

            <Button Content="Nuevo" Command="{Binding NuevoCommand}" Margin="0,16,0,4" Height="32" />
            <Button Content="Guardar" Click="GuardarButton_Click" Margin="0,0,0,4" Height="32" />
            <Button Content="Activar / Desactivar" Command="{Binding CambiarEstadoCommand}" Height="32" />
        </StackPanel>
    </Grid>
</Window>
