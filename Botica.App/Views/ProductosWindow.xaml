<Window x:Class="Botica.App.Views.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Productos" Height="650" Width="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Buscar" Command="{Binding BuscarCommand}" Width="80" />
        </Grid>

        <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Productos}"
                  SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria.Nombre}" Width="120" />
                <DataGridTextColumn Header="Laboratorio" Binding="{Binding Laboratorio.Nombre}" Width="120" />
                <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat={}{0:N2}}" Width="70" />
                <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="60" />
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Código" Margin="0,0,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.Codigo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Código de barras" Margin="0,8,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.CodigoBarras, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Nombre" Margin="0,8,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.Nombre, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Nombre genérico" Margin="0,8,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.NombreGenerico, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Categoría" Margin="0,8,0,4" />
                <ComboBox ItemsSource="{Binding CategoriasDisponibles}" DisplayMemberPath="Nombre"
                          SelectedValuePath="Id" SelectedValue="{Binding ProductoSeleccionado.CategoriaId}" />

                <TextBlock Text="Laboratorio" Margin="0,8,0,4" />
                <ComboBox ItemsSource="{Binding LaboratoriosDisponibles}" DisplayMemberPath="Nombre"
                          SelectedValuePath="Id" SelectedValue="{Binding ProductoSeleccionado.LaboratorioId}" />

                <TextBlock Text="Presentación" Margin="0,8,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.Presentacion, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Concentración" Margin="0,8,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.Concentracion, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Unidad de medida" Margin="0,8,0,4" />
                <TextBox Text="{Binding ProductoSeleccionado.UnidadMedida, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Precio compra" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProductoSeleccionado.PrecioCompra, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Precio venta" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProductoSeleccionado.PrecioVenta, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stock mínimo" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProductoSeleccionado.StockMinimo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stock actual" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProductoSeleccionado.StockActual, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Requiere receta" IsChecked="{Binding ProductoSeleccionado.RequiereReceta}" Margin="0,12,0,0" />
                <CheckBox Content="Activo" IsChecked="{Binding ProductoSeleccionado.Activo}" Margin="0,8,0,0" />

                <TextBlock Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

                <Button Content="Nuevo" Command="{Binding NuevoCommand}" Margin="0,16,0,4" Height="32"
                        Style="{StaticResource Style.SecondaryButton}" />
                <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,0,0,4" Height="32" />
                <Button Content="Activar / Desactivar" Command="{Binding CambiarEstadoCommand}" Margin="0,0,0,4" Height="32" />
                <Button Content="Eliminar" Command="{Binding EliminarCommand}" Height="32"
                        Style="{StaticResource Style.DangerButton}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
