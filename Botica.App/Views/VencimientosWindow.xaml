<Window x:Class="Botica.App.Views.VencimientosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vencimientos" Height="600" Width="800"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Días de anticipación:" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding DiasAnticipacion, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="4" Content="Actualizar" Command="{Binding CargarCommand}" Width="100" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Productos próximos a vencer" FontWeight="Bold" FontSize="14" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding ProximosAVencer}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto.Nombre}" Width="*" />
                <DataGridTextColumn Header="N° Lote" Binding="{Binding NumeroLote}" Width="100" />
                <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat={}{0:d}}" Width="100" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadActual}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="Productos vencidos" FontWeight="Bold" FontSize="14" Foreground="Red" />
        <DataGrid Grid.Row="6" ItemsSource="{Binding Vencidos}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto.Nombre}" Width="*" />
                <DataGridTextColumn Header="N° Lote" Binding="{Binding NumeroLote}" Width="100" />
                <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat={}{0:d}}" Width="100" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadActual}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
