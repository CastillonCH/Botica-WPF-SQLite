<Window x:Class="Botica.App.Views.CambiarContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cambiar contraseña" Height="360" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Contraseña actual" Margin="0,0,0,4" />
        <PasswordBox x:Name="ActualPasswordBox" />

        <TextBlock Text="Nueva contraseña" Margin="0,12,0,4" />
        <PasswordBox x:Name="NuevaPasswordBox" />

        <TextBlock Text="Confirmar nueva contraseña" Margin="0,12,0,4" />
        <PasswordBox x:Name="ConfirmarPasswordBox" />

        <TextBlock Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

        <Button Content="Guardar" Click="GuardarButton_Click" Margin="0,16,0,0" Height="36" />
    </StackPanel>
</Window>
