<Window x:Class="Botica.App.Views.VentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ventas" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Buscar" Command="{Binding BuscarCommand}" Width="80" />
            <Button Grid.Column="4" Content="Agregar" Command="{Binding AgregarAlCarritoCommand}" Width="90" />
        </Grid>

        <DataGrid Grid.Row="4" Grid.Column="0" ItemsSource="{Binding ResultadosBusqueda}"
                  SelectedItem="{Binding ProductoSeleccionadoBusqueda, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat={}{0:N2}}" Width="70" />
                <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Carrito" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />

        <DataGrid Grid.Row="6" Grid.Column="0" Margin="0,24,0,0" ItemsSource="{Binding Carrito}"
                  SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Height="220">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="70" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioUnitario, StringFormat={}{0:N2}}" Width="70" />
                <DataGridTemplateColumn Header="Cantidad" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Descuento" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Descuento, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:N2}}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="6" Grid.Column="0" Content="Quitar del carrito" Command="{Binding QuitarDelCarritoCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="140" />

        <StackPanel Grid.Row="0" Grid.RowSpan="7" Grid.Column="2">
            <TextBlock Text="Subtotal" FontSize="14" />
            <TextBlock Text="{Binding SubtotalSinIgv, StringFormat={}S/ {0:N2}}" FontSize="18" Margin="0,0,0,8" />

            <TextBlock Text="{Binding EtiquetaIgv}" FontSize="14" />
            <TextBlock Text="{Binding Igv, StringFormat={}S/ {0:N2}}" FontSize="18" Margin="0,0,0,8" />

            <TextBlock Text="Total" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="{Binding Total, StringFormat={}S/ {0:N2}}" FontSize="26" FontWeight="Bold" Margin="0,0,0,16" />

            <TextBlock Text="Método de pago" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoPago}" />

            <TextBlock Text="Monto recibido" Margin="0,12,0,4" />
            <TextBox Text="{Binding MontoRecibido, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Vuelto" Margin="0,12,0,4" />
            <TextBlock Text="{Binding Vuelto, StringFormat={}S/ {0:N2}}" FontSize="18" />

            <Button Content="Confirmar venta" Command="{Binding ConfirmarVentaCommand}" Margin="0,24,0,4" Height="40" />
            <Button Content="Nueva venta" Command="{Binding NuevaVentaCommand}" Height="32" />

            <TextBlock Text="Ventas de esta caja" FontWeight="Bold" Margin="0,24,0,4" />
            <DataGrid ItemsSource="{Binding HistorialCajaActual}"
                      SelectedItem="{Binding VentaSeleccionadaHistorial, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Height="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat={}{0:t}}" Width="60" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="60" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Motivo de anulación" Margin="0,8,0,4" />
            <TextBox Text="{Binding MotivoAnulacion, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Anular venta seleccionada" Command="{Binding AnularVentaCommand}" Margin="0,8,0,0"
                    Height="32" />
        </StackPanel>
    </Grid>
</Window>
