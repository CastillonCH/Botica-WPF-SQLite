<Window x:Class="Botica.App.Views.CajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Caja" Height="600" Width="750"
        MinHeight="480" MinWidth="650"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" />

        <!-- Sin caja abierta -->
        <StackPanel Grid.Row="2" Visibility="{Binding NoHayCajaAbierta, Converter={StaticResource BoolToVisibility}}"
                    MaxWidth="320">
            <TextBlock Text="No hay una caja abierta." FontSize="16" Margin="0,0,0,12" />
            <TextBlock Text="Monto de apertura" Margin="0,0,0,4" />
            <TextBox Text="{Binding MontoAperturaNuevo, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Abrir caja" Command="{Binding AbrirCajaCommand}" Margin="0,12,0,0" Height="36" />
        </StackPanel>

        <!-- Caja abierta -->
        <Grid Grid.Row="2" Visibility="{Binding HayCajaAbierta, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding CajaActual.FechaApertura, StringFormat={}Apertura: {0:g}}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding CajaActual.MontoApertura, StringFormat={}Monto de apertura: S/ {0:N2}}"
                           Margin="0,0,0,12" />

                <TextBlock Text="Movimientos" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" IsReadOnly="True"
                          Height="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat={}{0:g}}" Width="120" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70" />
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" />
                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:N2}}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Registrar movimiento" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Concepto" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ConceptoMovimiento, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Monto" Margin="0,8,0,4" />
                    <TextBox Text="{Binding MontoMovimiento, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Ingreso" Command="{Binding RegistrarIngresoCommand}" Height="32" />
                        <Button Grid.Column="2" Content="Egreso" Command="{Binding RegistrarEgresoCommand}" Height="32" />
                    </Grid>

                    <Separator Margin="0,20,0,20" />

                    <TextBlock Text="Cierre de caja" FontWeight="Bold" Margin="0,0,0,8" />
                    <Button Content="Calcular monto de sistema" Command="{Binding CalcularCierreCommand}" Height="32" />
                    <TextBlock Text="{Binding MontoSistemaCalculado, StringFormat={}Monto de sistema: S/ {0:N2}}"
                               Margin="0,8,0,8" />

                    <TextBlock Text="Monto declarado (arqueo)" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MontoDeclaradoCierre, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Cerrar caja" Command="{Binding CerrarCajaCommand}" Margin="0,12,0,0" Height="36" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
