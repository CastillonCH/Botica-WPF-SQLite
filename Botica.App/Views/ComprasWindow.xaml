<Window x:Class="Botica.App.Views.ComprasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Compras" Height="700" Width="1100"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Proveedor" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ProveedoresDisponibles}" DisplayMemberPath="RazonSocial"
                          SelectedItem="{Binding ProveedorSeleccionado}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="N° de comprobante" Margin="0,0,0,4" />
                <TextBox Text="{Binding NumeroComprobante, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Buscar" Command="{Binding BuscarCommand}" Width="80" />
            <Button Grid.Column="4" Content="Agregar" Command="{Binding AgregarAlCarritoCommand}" Width="90" />
        </Grid>

        <DataGrid Grid.Row="6" ItemsSource="{Binding ResultadosBusqueda}"
                  SelectedItem="{Binding ProductoSeleccionadoBusqueda, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="140"
                  VerticalAlignment="Top">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="P. Compra" Binding="{Binding PrecioCompra, StringFormat={}{0:N2}}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" Text="Detalle de compra" FontWeight="Bold" Margin="0,150,0,0" VerticalAlignment="Top" />

        <DataGrid Grid.Row="6" Margin="0,174,0,0" ItemsSource="{Binding Carrito}"
                  SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="70" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTemplateColumn Header="Cantidad" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="P. Unitario" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="N° Lote" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding NumeroLote, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Vencimiento" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding FechaVencimiento, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:N2}}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="6" Content="Quitar" Command="{Binding QuitarDelCarritoCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,0,0" Width="100" />

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Total, StringFormat={}Total: S/ {0:N2}}" FontSize="20"
                       FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Nueva compra" Command="{Binding NuevaCompraCommand}" Width="120" Height="36"
                        Margin="0,0,8,0" />
                <Button Content="Confirmar compra" Command="{Binding ConfirmarCompraCommand}" Width="150" Height="36" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
