<Window x:Class="Botica.App.Views.ProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Proveedores" Height="500" Width="750"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Buscar" Command="{Binding CargarCommand}" Width="80" />
        </Grid>

        <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Proveedores}"
                  SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Razón social" Binding="{Binding RazonSocial}" Width="*" />
                <DataGridTextColumn Header="RUC" Binding="{Binding Ruc}" Width="100" />
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="100" />
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2">
            <TextBlock Text="Razón social" Margin="0,0,0,4" />
            <TextBox Text="{Binding ProveedorSeleccionado.RazonSocial, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="RUC" Margin="0,8,0,4" />
            <TextBox Text="{Binding ProveedorSeleccionado.Ruc, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Dirección" Margin="0,8,0,4" />
            <TextBox Text="{Binding ProveedorSeleccionado.Direccion, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Teléfono" Margin="0,8,0,4" />
            <TextBox Text="{Binding ProveedorSeleccionado.Telefono, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Activo" IsChecked="{Binding ProveedorSeleccionado.Activo}" Margin="0,12,0,0" />

            <TextBlock Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

            <Button Content="Nuevo" Command="{Binding NuevoCommand}" Margin="0,16,0,4" Height="32"
                    Style="{StaticResource Style.SecondaryButton}" />
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,0,0,4" Height="32" />
            <Button Content="Eliminar" Command="{Binding EliminarCommand}" Height="32"
                    Style="{StaticResource Style.DangerButton}" />
        </StackPanel>
    </Grid>
</Window>
