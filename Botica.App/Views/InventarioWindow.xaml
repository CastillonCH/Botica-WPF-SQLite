<Window x:Class="Botica.App.Views.InventarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inventario / Kardex" Height="700" Width="1050"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Buscar" Command="{Binding BuscarCommand}" Width="80" />
        </Grid>

        <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding ResultadosBusqueda}"
                  SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Stock actual" Binding="{Binding StockActual}" Width="90" />
                <DataGridTextColumn Header="Stock mínimo" Binding="{Binding StockMinimo}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Kardex del producto seleccionado" FontWeight="Bold"
                    Margin="0,0,0,4" VerticalAlignment="Top" />
        <DataGrid Grid.Row="4" Grid.Column="0" Margin="0,24,0,0" ItemsSource="{Binding Kardex}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat={}{0:g}}" Width="120" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="110" />
                <DataGridTextColumn Header="Entrada" Binding="{Binding Entrada}" Width="70" />
                <DataGridTextColumn Header="Salida" Binding="{Binding Salida}" Width="70" />
                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="70" />
                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Ajustar stock" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                <TextBlock Text="Producto seleccionado" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ProductoSeleccionado.Nombre}" FontWeight="Bold" TextWrapping="Wrap" />

                <TextBlock Text="Tipo" Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding TiposAjuste}" SelectedItem="{Binding TipoAjuste}" />

                <TextBlock Text="Cantidad" Margin="0,8,0,4" />
                <TextBox Text="{Binding CantidadAjuste, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Motivo" Margin="0,8,0,4" />
                <TextBox Text="{Binding MotivoAjuste, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         Height="60" TextWrapping="Wrap" />

                <TextBlock Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

                <Button Content="Registrar ajuste" Command="{Binding RegistrarAjusteCommand}" Margin="0,16,0,0"
                        Height="36" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
