<Window x:Class="Botica.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Botica" Height="680" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Style.SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6FFFA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#E6FFFA"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.SidebarHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#20FFFFFF" CornerRadius="8" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.SidebarSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5EEAD4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="14,18,14,6" />
        </Style>

        <Style x:Key="Style.StatCard" TargetType="Border" BasedOn="{StaticResource Style.Card}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource Effect.CardShadowHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource Brush.Background}">
        <!-- Encabezado -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.HeroGradient}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#26FFFFFF">
                        <Grid>
                            <Rectangle Width="18" Height="6" Fill="White" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle Width="6" Height="18" Fill="White" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Botica" Foreground="White" FontSize="19" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#26FFFFFF" Margin="0,0,10,0">
                        <TextBlock x:Name="InicialUsuarioTextBlock" Foreground="White" FontWeight="Bold"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="UsuarioConectadoTextBlock" Foreground="White" VerticalAlignment="Center"
                               FontSize="13" Margin="0,0,16,0" />
                    <Button Content="Cambiar contraseña" Style="{StaticResource Style.HeaderButton}"
                            Click="CambiarContrasenaButton_Click" Margin="0,0,8,0" />
                    <Button Content="Cerrar sesión" Style="{StaticResource Style.HeaderButton}"
                            Click="CerrarSesionButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra lateral -->
        <Border DockPanel.Dock="Left" Background="{StaticResource Brush.SidebarGradient}" Width="200" Padding="8,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="OPERACIONES" Style="{StaticResource Style.SidebarSectionLabel}" />
                    <Button Content="Ventas" Click="VentasButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Caja" Click="CajaButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Compras" Click="ComprasButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Inventario" Click="InventarioButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Vencimientos" Click="VencimientosButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Reportes" Click="ReportesButton_Click" Style="{StaticResource Style.SidebarButton}" />

                    <TextBlock Text="CATÁLOGO" Style="{StaticResource Style.SidebarSectionLabel}" />
                    <Button Content="Productos" Click="ProductosButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Categorías" Click="CategoriasButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Laboratorios" Click="LaboratoriosButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button Content="Proveedores" Click="ProveedoresButton_Click" Style="{StaticResource Style.SidebarButton}" />

                    <TextBlock x:Name="AdministracionLabel" Text="ADMINISTRACIÓN" Style="{StaticResource Style.SidebarSectionLabel}" />
                    <Button x:Name="UsuariosButton" Content="Usuarios" Click="UsuariosButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button x:Name="BackupsButton" Content="Respaldos" Click="BackupsButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button x:Name="ConfiguracionButton" Content="Configuración" Click="ConfiguracionButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button x:Name="AuditoriaButton" Content="Auditoría" Click="AuditoriaButton_Click" Style="{StaticResource Style.SidebarButton}" />
                    <Button x:Name="ImportacionButton" Content="Importación" Click="ImportacionButton_Click" Style="{StaticResource Style.SidebarButton}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Dashboard -->
        <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Background}">
            <StackPanel Margin="24">
                <TextBlock Text="Resumen general" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Un vistazo rápido al estado de tu botica" Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="13" Margin="0,0,0,20" />

                <UniformGrid Columns="4" Rows="2">
                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.Primary}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="VENTAS DEL DÍA" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding VentasDelDia, StringFormat={}S/ {0:N2}}" FontSize="22"
                                           FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.Success}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="VENTAS DEL MES" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding VentasDelMes, StringFormat={}S/ {0:N2}}" FontSize="22"
                                           FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.Accent}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="COMPRAS DEL MES" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding ComprasDelMes, StringFormat={}S/ {0:N2}}" FontSize="22"
                                           FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.PrimaryDark}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="GANANCIA DEL MES" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding GananciaDelMes, StringFormat={}S/ {0:N2}}" FontSize="22"
                                           FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.Warning}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="STOCK BAJO" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding ProductosStockBajo}" FontSize="22" FontWeight="Bold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.Danger}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="AGOTADOS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding ProductosAgotados}" FontSize="22" FontWeight="Bold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="#D97706" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="PRÓX. A VENCER (90D)" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding ProductosProximosAVencer}" FontSize="22" FontWeight="Bold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Style.StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="{StaticResource Brush.TextSecondary}" />
                            <StackPanel Grid.Row="1" Margin="16,14">
                                <TextBlock Text="VENCIDOS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding ProductosVencidos}" FontSize="22" FontWeight="Bold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Style.Card}">
                        <StackPanel>
                            <TextBlock Text="Productos más vendidos" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding ProductosMasVendidos}" AutoGenerateColumns="False"
                                      IsReadOnly="True" Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                                    <DataGridTextColumn Header="Cant." Binding="{Binding CantidadVendida}" Width="50" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Style.Card}">
                        <StackPanel>
                            <TextBlock Text="Últimas ventas" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding UltimasVentas}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat={}{0:g}}" Width="110" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Style.Card}">
                        <StackPanel>
                            <TextBlock Text="Últimas compras" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding UltimasCompras}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor.RazonSocial}" Width="*" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
