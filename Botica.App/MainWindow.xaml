<Window x:Class="Botica.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Botica" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Botica" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="UsuarioConectadoTextBlock" Foreground="White" VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button Content="Cerrar sesión" Click="CerrarSesionButton_Click" Padding="10,4" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Background="#ECF0F1" Width="180" Padding="8">
            <StackPanel>
                <Button Content="Productos" Click="ProductosButton_Click" Margin="0,0,0,6" Height="34" />
                <Button Content="Categorías" Click="CategoriasButton_Click" Margin="0,0,0,6" Height="34" />
                <Button Content="Laboratorios" Click="LaboratoriosButton_Click" Margin="0,0,0,6" Height="34" />
            </StackPanel>
        </Border>

        <Grid>
            <TextBlock Text="Dashboard (próximamente)" FontSize="20" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="Gray" />
        </Grid>
    </DockPanel>
</Window>
