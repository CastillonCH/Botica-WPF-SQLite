<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Primary">#0D9488</Color>
    <Color x:Key="Color.PrimaryDark">#0F766E</Color>
    <Color x:Key="Color.PrimaryDarker">#134E4A</Color>
    <Color x:Key="Color.PrimaryLight">#5EEAD4</Color>
    <Color x:Key="Color.PrimarySoft">#CCFBF1</Color>
    <Color x:Key="Color.Accent">#F97066</Color>
    <Color x:Key="Color.AccentDark">#E4573F</Color>
    <Color x:Key="Color.Background">#F1F5F9</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Border">#E2E8F0</Color>
    <Color x:Key="Color.TextPrimary">#0F172A</Color>
    <Color x:Key="Color.TextSecondary">#64748B</Color>
    <Color x:Key="Color.Success">#10B981</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.DangerDark">#DC2626</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryDark" Color="{StaticResource Color.PrimaryDark}" />
    <SolidColorBrush x:Key="Brush.PrimaryDarker" Color="{StaticResource Color.PrimaryDarker}" />
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="{StaticResource Color.PrimaryLight}" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource Color.PrimarySoft}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Color.AccentDark}" />
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerDark" Color="{StaticResource Color.DangerDark}" />
    <SolidColorBrush x:Key="Brush.White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#0D9488" Opacity="0.06" />

    <LinearGradientBrush x:Key="Brush.HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.PrimaryDarker}" Offset="0" />
        <GradientStop Color="{StaticResource Color.PrimaryDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B3B37" Offset="0" />
        <GradientStop Color="{StaticResource Color.PrimaryDarker}" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Effect.CardShadow" Color="#0F172A" BlurRadius="18" ShadowDepth="3" Direction="270"
                       Opacity="0.10" />
    <DropShadowEffect x:Key="Effect.CardShadowHover" Color="#0F172A" BlurRadius="24" ShadowDepth="6" Direction="270"
                       Opacity="0.16" />

</ResourceDictionary>
